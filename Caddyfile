:{$PORT:8080} {
    root * /app
    encode gzip
    
    # Handle PHP files
    @php {
        path *.php
    }
    
    php_server @php
    
    # Try files first, then PHP
    try_files {path} {path}.php /index.php
    
    # File server untuk static assets
    file_server {
        hide .git*
        hide Caddyfile*
        hide *.md
    }
}
